# vim: set filetype=zsh:
# # .zshrc
# #

# shellcheck disable=SC1090,SC1091,SC2296

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
# if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
#   source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
# fi

# Activate mise before zimfw, because a zim rebuild runs the completion
# generators in zimrc and several of those CLIs (clerk, eas) are npm shims with
# a `#!/usr/bin/env node` shebang. Without node on PATH they fail and truncate
# their completion file to zero bytes.
eval "$(mise activate zsh)"

# # Use zim's degit tool to install modules
zstyle ':zim:zmodule' use 'degit'

# # Set ZIM home directory
ZIM_HOME="${XDG_CACHE_HOME}/zim"

# # Keep the zim config out of $HOME; zimfw defaults to ${ZDOTDIR:-$HOME}/.zimrc
ZIM_CONFIG_FILE="${ZSH_CONFIG_HOME}/zimrc"

# # Download zimfw plugin manager if missing.
if [[ ! -e ${ZIM_HOME}/zimfw.zsh ]]; then
  curl -fsSL --create-dirs -o "${ZIM_HOME}"/zimfw.zsh \
    https://github.com/zimfw/zimfw/releases/latest/download/zimfw.zsh
fi

ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#3b4048,underline'

# # Install missing modules, and update ${ZIM_HOME}/init.zsh if missing or outdated.
if [[ ! ${ZIM_HOME}/init.zsh -nt ${ZIM_CONFIG_FILE} ]]; then
  . "${ZIM_HOME}"/zimfw.zsh init -q
fi

zstyle ':zim:completion' dumpfile ${XDG_CACHE_HOME}/zsh/zcompdump
# # Sets the cache path for zsh completions
zstyle ':completion::complete:*' cache-path ${XDG_CACHE_HOME}/zsh/zcompcache
# # Enables an interactive selection menu for tab completions where you can select the completion with tab/shift-tab
zstyle ':completion:*:*:*:default' menu yes select search
# # Shows a list of processes to kill when using kill commands
zstyle ':completion:*:*:kill:*' menu yes select
# # Ensures a list is always shown when using kill commands
zstyle ':completion:*:kill:*' force-list always
# # Sets description text to bold for completion menu
zstyle ":completion:*:descriptions" format "%B%d%b"
# # Allows for case-insensitive completion
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
# # Use colors in LS_COLORS for displaying file lists in completion
zstyle ':completion:*:default' list-colors "${(s.:.)LS_COLORS}"

# # Pre-load bashcompinit before zimfw to avoid duplicate compinit warnings
# # This ensures bash completion support is available when zimfw initializes
autoload -Uz bashcompinit

# # Initialize modules.
. "${ZIM_HOME}"/init.zsh

# # In the completion menu's incremental search, Space accepts the current
# # highlight, exits the menu, and inserts a space (no more "failed isearch")
# Helpful when completing a path and you want to add a space after the path without having to press Tab again.
zmodload -i zsh/complist
accept-and-space() { zle accept-search; zle .self-insert; }
zle -N accept-and-space
bindkey -M menuselect ' ' accept-and-space

# Enter accepts the highlighted match and runs the line in one press. Without
# the leading `.`, accept-line is "special" inside menuselect and only exits
# the incremental search, which is why it otherwise takes three presses.
bindkey -M menuselect '^M' .accept-line
# bindkey -M menuselect '^J' .accept-line

# /etc/zshrc sets HISTFILE/HISTSIZE/SAVEHIST, so these must come after it
HISTSIZE='1000000000'
SAVEHIST='1000000000'
HISTFILE="$XDG_STATE_HOME/zsh/history"

# More information on zsh options https://zsh.sourceforge.io/Doc/Release/Options.html
# try to make the completion list smaller (occupying less lines) by printing the matches in columns with different widths.
setopt list_packed
# share history across multiple zsh sessions
setopt append_history
# add more data to history file 
setopt extended_history
# adds commands as they are typed, not at shell exit
setopt inc_append_history
# causes oldest history event that has a duplicate to be lost before a unique event is lost
setopt hist_expire_dups_first
# when searching history, do not display results already cycled through
setopt hist_find_no_dups
# do not store a command in the history list if it matches the previous command
setopt hist_ignore_dups
# remove command from history list when first character is a space
setopt hist_ignore_space
# when entering a line with history expansion, don't execute the line 
setopt hist_verify
# when writing out history file, older commands that duplicate newer ones are omitted
setopt hist_save_no_dups
# don't try to correct command line spelling for command args
unsetopt correctall

# Don't highlight pasted text
# https://unix.stackexchange.com/questions/331850/zsh-selects-a-pasted-text#331877
zle_highlight=('paste:none')

autoload -Uz zcalc colors

# To customize prompt, run `p10k configure` or edit $ZSH_CONFIG_HOME/.p10k.zsh.
# [[ ! -f "$ZSH_CONFIG_HOME/.p10k.zsh" ]] || source "$ZSH_CONFIG_HOME/.p10k.zsh"
#
# # Temporary solution for loading mise plugin versions in p10k right prompt
# [[ ! -f "$ZSH_CONFIG_HOME/.p10k.mise.zsh" ]] || source "$ZSH_CONFIG_HOME/.p10k.mise.zsh"

eval "$(starship init zsh)"

# Load syntax highlighting
eval "$("$(brew --prefix)"/bin/zsh-patina activate)"

# Set some configuration if commands are available
# Use vivid to generate a themed LS_COLORS
# [[ -n "$(command -v vivid)" ]] && export LS_COLORS="$(vivid generate tokyonight-storm)"

# Load shell settings
if [ -d "$XDG_CONFIG_HOME/shell" ]; then
  for file in "$XDG_CONFIG_HOME"/shell/*.zsh; do
    . "$file"
  done
fi
