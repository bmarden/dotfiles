# Ghostty config, ported from ~/.config/kitty/kitty.conf

theme = TokyoNight Night

font-family = MonoLisaCode
font-style = ExtraLight
font-size = 11

# kitty's `features=` on font_family carry over one per line
font-feature = cv01
font-feature = cv02
font-feature = cv03
font-feature = cv04
font-feature = cv08
font-feature = cv09
font-feature = cv10
font-feature = cv11
font-feature = ss13
font-feature = ss04
font-feature = liga
font-feature = dlig

# kitty: window_padding_width 3 5 2 2 (ghostty has no per-side control)
window-padding-x = 3
window-padding-y = 2
window-padding-balance = true

# kitty: hide_window_decorations titlebar-only
macos-titlebar-style = tabs
macos-option-as-alt = true

# kitty: confirm_os_window_close 0
confirm-close-surface = false

# kitty: enable_audio_bell no / visual_bell_duration 0.0
bell-features = no-audio,no-attention,no-title

scrollback-limit = 10000000
shell-integration = zsh
shell-integration-features = cursor,title,sudo

# Splits: kitty_mod (cmd+option) + h/v
keybind = super+alt+v=new_split:right
keybind = super+alt+h=new_split:down
keybind = super+enter=new_split:down
keybind = super+alt+w=close_surface

# smart-splits.nvim's backend-ghostty owns ctrl+hjkl and alt+shift+hjkl
# at runtime, so no navigation/resize binds for those here.
keybind = super+alt+left=goto_split:left
keybind = super+alt+right=goto_split:right
keybind = super+alt+up=goto_split:up
keybind = super+alt+down=goto_split:down

keybind = ctrl+comma=equalize_splits
keybind = super+alt+z=toggle_split_zoom

# Tabs
keybind = super+t=new_tab
keybind = super+alt+bracket_right=move_tab:1
keybind = super+alt+bracket_left=move_tab:-1

# Scrollback into nvim (replaces kitty-scrollback.nvim's kitty_mod+i)
keybind = super+alt+i=write_scrollback_file:open
keybind = super+alt+g=write_screen_file:open

##############################################################################
#                    smart-splits.nvim / backend-ghostty                     #
##############################################################################
# `performable:` gives Neovim first chance at the key; the `nvim/` key table
# is activated by the plugin while Neovim is running. Resize uses
# alt+shift+hjkl to match the <A-S-...> maps in nvim/lua/config/keymaps.lua.

# Outside Neovim.
keybind = performable:ctrl+h=goto_split:left
keybind = performable:ctrl+j=goto_split:down
keybind = performable:ctrl+k=goto_split:up
keybind = performable:ctrl+l=goto_split:right

keybind = performable:alt+shift+h=resize_split:left,30
keybind = performable:alt+shift+j=resize_split:down,30
keybind = performable:alt+shift+k=resize_split:up,30
keybind = performable:alt+shift+l=resize_split:right,30

# Inside Neovim.
keybind = nvim/
keybind = nvim/ctrl+h=text:\x08
keybind = nvim/ctrl+j=text:\x0a
keybind = nvim/ctrl+k=text:\x0b
keybind = nvim/ctrl+l=text:\x0c

keybind = nvim/alt+shift+h=esc:H
keybind = nvim/alt+shift+j=esc:J
keybind = nvim/alt+shift+k=esc:K
keybind = nvim/alt+shift+l=esc:L
